---
// Encabezado fijo del sitio público. "Iniciar sesión" lleva al acceso (/login) y,
// tras iniciar sesión, el usuario entra al catálogo del panel (CRUD).
// En móvil el menú se abre con <details>, sin JavaScript.
import Logo from "./Logo.astro";

const links = [
	{ href: "/", label: "Inicio" },
	{ href: "/#destinos", label: "Destinos" },
	{ href: "/#tours", label: "Tours" },
	{ href: "/#como-funciona", label: "Cómo funciona" },
];
---

<header class="sticky top-0 z-50 border-b border-borde/50 bg-white/90 backdrop-blur-md">
	<div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
		<Logo />

		<nav aria-label="Principal" class="hidden lg:block">
			<ul class="flex items-center gap-8 text-sm font-medium text-tinta">
				{
					links.map((link, index) => (
						<li>
							<a
								href={link.href}
								class:list={[
									"relative py-2 transition-colors hover:text-terracota",
									index === 0 &&
										"text-terracota after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-terracota",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="hidden items-center gap-3 sm:flex">
			<a
				href="/login#iniciar-sesion"
				class="rounded-full border border-selva/30 px-5 py-2 text-sm font-semibold text-selva transition-colors hover:border-selva hover:bg-selva hover:text-white"
			>
				Iniciar sesión
			</a>
			<a
				href="/#cotizar"
				class="hidden rounded-full bg-terracota px-5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-terracota-oscuro md:inline-block"
			>
				Solicitar cotización
			</a>
		</div>

		<!-- Menú móvil -->
		<details class="group relative lg:hidden">
			<summary
				class="flex cursor-pointer list-none items-center rounded-full border border-borde px-4 py-2 text-sm font-semibold text-selva [&::-webkit-details-marker]:hidden"
			>
				<span class="group-open:hidden">Menú</span>
				<span class="hidden group-open:inline">Cerrar</span>
			</summary>
			<div class="absolute right-0 mt-2 w-64 rounded-2xl border border-borde bg-white p-3 shadow-xl">
				<ul class="flex flex-col text-sm font-medium text-tinta">
					{
						links.map((link) => (
							<li>
								<a href={link.href} class="block rounded-lg px-3 py-2 hover:bg-crema">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
				<div class="mt-3 flex flex-col gap-2 border-t border-borde pt-3">
					<a
						href="/login#iniciar-sesion"
						class="rounded-full border border-selva px-4 py-2 text-center text-sm font-semibold text-selva sm:hidden"
					>
						Iniciar sesión
					</a>
					<a
						href="/#cotizar"
						class="rounded-full bg-terracota px-4 py-2 text-center text-sm font-semibold text-white"
					>
						Solicitar cotización
					</a>
				</div>
			</div>
		</details>
	</div>
</header>
