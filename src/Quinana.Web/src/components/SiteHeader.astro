---
// Encabezado fijo del sitio público. "Iniciar sesión" lleva al acceso (/login) y,
// tras iniciar sesión, el usuario entra al catálogo del panel (CRUD).
// En móvil el menú se abre con <details>, sin JavaScript.
import { homePath, t, type Lang } from "../i18n/ui";
import Logo from "./Logo.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang).nav;
const home = homePath[lang];
const other: Lang = lang === "es" ? "en" : "es";

const links = [
	{ href: `${home}#destinos`, label: text.destinations },
	{ href: `${home}#tours`, label: text.tours },
	{ href: `${home}#como-funciona`, label: text.how },
];
---

<header class="sticky top-0 z-50 border-b border-borde/60 bg-white/95 backdrop-blur-md">
	<div class="mx-auto flex h-18 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
		<Logo lang={lang} />

		<nav aria-label={lang === "es" ? "Principal" : "Main"} class="hidden lg:block">
			<ul class="flex items-center gap-8 text-sm font-medium text-tinta">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="py-2 transition-colors hover:text-terracota">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="hidden items-center gap-5 sm:flex">
			<a href={homePath[other]} hreflang={other} lang={other} class="text-sm font-medium text-musgo hover:text-terracota">
				{text.switchTo}
			</a>
			<a href="/login#iniciar-sesion" class="text-sm font-semibold text-selva hover:text-terracota">
				{text.login}
			</a>
			<a
				href={`${home}#cotizar`}
				class="hidden rounded-full bg-terracota px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-terracota-oscuro md:inline-block"
			>
				{text.quote}
			</a>
		</div>

		<!-- Menú móvil -->
		<details class="group relative lg:hidden">
			<summary
				class="flex cursor-pointer list-none items-center rounded-full border border-borde px-4 py-2 text-sm font-semibold text-selva [&::-webkit-details-marker]:hidden"
			>
				<span class="group-open:hidden">{text.menu}</span>
				<span class="hidden group-open:inline">{text.close}</span>
			</summary>
			<div class="absolute right-0 mt-2 w-64 rounded-2xl border border-borde bg-white p-3 shadow-xl">
				<ul class="flex flex-col text-sm font-medium text-tinta">
					{
						links.map((link) => (
							<li>
								<a href={link.href} class="block rounded-lg px-3 py-2 hover:bg-crema">
									{link.label}
								</a>
							</li>
						))
					}
					<li class="sm:hidden">
						<a href={homePath[other]} hreflang={other} lang={other} class="block rounded-lg px-3 py-2 hover:bg-crema">
							{text.switchTo}
						</a>
					</li>
				</ul>
				<div class="mt-3 flex flex-col gap-2 border-t border-borde pt-3">
					<a
						href="/login#iniciar-sesion"
						class="rounded-full border border-selva px-4 py-2 text-center text-sm font-semibold text-selva sm:hidden"
					>
						{text.login}
					</a>
					<a
						href={`${home}#cotizar`}
						class="rounded-full bg-terracota px-4 py-2 text-center text-sm font-semibold text-white"
					>
						{text.quote}
					</a>
				</div>
			</div>
		</details>
	</div>
</header>
