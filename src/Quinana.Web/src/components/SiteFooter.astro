---
import { homePath, t, type Lang } from "../i18n/ui";
import { bannerCredit, regions } from "../lib/regions";
import Logo from "./Logo.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
const home = homePath[lang];
const year = new Date().getFullYear();
// Las licencias CC BY-SA exigen dar crédito al autor de cada foto.
const credits = [...regions.map((region) => region.credit), bannerCredit];
---

<footer class="border-t border-borde/60 bg-white">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
		<div>
			<Logo lang={lang} />
			<p class="mt-4 max-w-xs text-sm leading-relaxed text-musgo">{text.footer.about}</p>
		</div>

		<nav aria-label={text.footer.explore}>
			<p class="text-sm font-bold text-tinta">{text.footer.explore}</p>
			<ul class="mt-4 space-y-2.5 text-sm text-musgo">
				<li><a href={`${home}#destinos`} class="hover:text-terracota">{text.nav.destinations}</a></li>
				<li><a href={`${home}#tours`} class="hover:text-terracota">{text.nav.tours}</a></li>
				<li><a href={`${home}#como-funciona`} class="hover:text-terracota">{text.nav.how}</a></li>
				<li><a href={`${home}#cotizar`} class="hover:text-terracota">{text.nav.quote}</a></li>
			</ul>
		</nav>

		<nav aria-label={text.footer.destinations}>
			<p class="text-sm font-bold text-tinta">{text.footer.destinations}</p>
			<ul class="mt-4 space-y-2.5 text-sm text-musgo">
				{regions.map((region) => (
					<li><a href={`${home}#destinos`} class="hover:text-terracota">{region.label[lang]}</a></li>
				))}
			</ul>
		</nav>

		<nav aria-label={text.footer.account}>
			<p class="text-sm font-bold text-tinta">{text.footer.account}</p>
			<ul class="mt-4 space-y-2.5 text-sm text-musgo">
				<li><a href="/login#iniciar-sesion" class="hover:text-terracota">{text.footer.login}</a></li>
				<li><a href="/login#registro" class="hover:text-terracota">{text.footer.register}</a></li>
			</ul>
		</nav>
	</div>

	<div class="border-t border-borde/60">
		<div class="mx-auto max-w-6xl space-y-2 px-4 py-6 text-xs text-musgo sm:px-6">
			<p>© {year} Quinana Tours. Ecuador.</p>
			<p>
				{text.footer.photos}{" "}
				{credits.map((credit, index) => (
					<>
						<a href={credit.url} class="underline hover:text-terracota" rel="noopener" target="_blank">
							{credit.subject}
						</a>{" "}
						({credit.author}, {credit.license}){index < credits.length - 1 ? "; " : "."}
					</>
				))}
				{" "}{text.footer.quilotoa}
			</p>
		</div>
	</div>
</footer>
