---
// Página principal pública. Los tours vienen del CRUD de Django (/api/tours/) y cada uno
// toma la foto de su región. El buscador del hero filtra esos tours en el navegador.
import { Image } from "astro:assets";
import banner from "../assets/destinos/cotopaxi-banner.jpg";
import quilotoa from "../assets/quilotoa.jpg";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { regionFor, regions } from "../lib/regions";
import { fetchTours, formatPrice } from "../lib/tours";

const tours = await fetchTours();

// Por región: cuántos tours hay y desde qué precio (datos reales del CRUD).
const regionStats = regions.map((region) => {
	const prices = tours.filter((t) => t.destination === region.name).map((t) => Number(t.price_usd));
	return { ...region, count: prices.length, from: prices.length ? Math.min(...prices) : null };
});

const features = [
	{ icon: "compass", title: "Expertos locales", text: "Vivimos en Ecuador y conocemos cada destino." },
	{ icon: "route", title: "Viajes a tu medida", text: "Ajustamos hoteles, ritmo y actividades." },
	{ icon: "shield", title: "Sin pagos por adelantado", text: "Confirmas solo cuando la propuesta te convence." },
	{ icon: "headset", title: "Acompañamiento", text: "Asistencia durante todo tu viaje." },
] as const;

const styles = [
	{ icon: "mountain", label: "Aventura" },
	{ icon: "beach", label: "Playa" },
	{ icon: "leaf", label: "Naturaleza" },
	{ icon: "landmark", label: "Cultura" },
	{ icon: "heart", label: "Luna de miel" },
	{ icon: "users", label: "Familia" },
] as const;

const steps = [
	{ title: "Cuéntanos tu viaje", text: "Fechas, viajeros y lo que te gustaría vivir. Sin compromiso." },
	{ title: "Recibe tu itinerario", text: "Un experto local arma una propuesta y la ajusta contigo." },
	{ title: "Viaja tranquilo", text: "Confirmas cuando estés seguro y te acompañamos en el viaje." },
];

const selectClass =
	"w-full cursor-pointer appearance-none bg-transparent text-sm font-medium text-tinta focus:outline-none";
---

<Layout
	title="Quinana Tours · Tours a tu medida por Ecuador"
	description="Tours personalizados por Galápagos, Andes, Amazonía y Costa de Ecuador. Solicita tu cotización y un experto local armará tu itinerario."
>
	<!-- ===================== Hero ===================== -->
	<section class="relative isolate overflow-hidden bg-crema">
		<Image
			src={quilotoa}
			alt="Laguna del Quilotoa, un lago de cráter turquesa rodeado de montañas en los Andes de Ecuador"
			class="absolute inset-0 -z-10 h-full w-full object-cover object-right"
			widths={[640, 1024, 1600]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div
			class="absolute inset-0 -z-10 bg-gradient-to-b from-crema/95 via-crema/80 to-crema/40 md:bg-gradient-to-r md:from-crema md:via-crema/85 md:to-transparent"
		>
		</div>

		<div class="mx-auto max-w-6xl px-4 pt-16 pb-36 sm:px-6 md:pt-24 md:pb-44">
			<p class="text-xs font-semibold tracking-[0.2em] text-musgo uppercase">Explora Ecuador</p>
			<h1 class="mt-4 max-w-xl text-5xl leading-[1.05] font-extrabold tracking-tight text-selva md:text-6xl">
				Descubre Ecuador.
				<span class="relative inline-block">
					Vive tu aventura.
					<svg
						class="absolute -bottom-3 left-0 h-3 w-full text-terracota"
						viewBox="0 0 300 12"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path d="M2 9c60-6 180-9 296-4" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
					</svg>
				</span>
			</h1>
			<p class="mt-8 max-w-md text-lg text-tinta/80">
				Islas, volcanes, selva y Pacífico en un solo país. Viajes inolvidables, armados a tu medida
				por expertos locales.
			</p>
			<a
				href="#tours"
				class="mt-8 inline-flex items-center gap-2 rounded-full bg-terracota px-7 py-3.5 font-semibold text-white shadow-lg shadow-terracota/30 transition-colors hover:bg-terracota-oscuro"
			>
				Explorar tours <Icon name="arrow" class="h-4 w-4" />
			</a>
		</div>
	</section>

	<!-- Buscador: filtra los tours de abajo -->
	<div class="relative z-10 mx-auto -mt-24 max-w-5xl px-4 sm:px-6">
		<form
			id="tour-search"
			class="grid gap-3 rounded-2xl bg-white p-4 shadow-xl shadow-laguna-profundo/10 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto] lg:items-center lg:gap-0 lg:divide-x lg:divide-borde lg:p-3"
		>
			<label class="flex items-center gap-3 rounded-xl px-3 py-2 lg:rounded-none">
				<Icon name="map-pin" class="h-5 w-5 shrink-0 text-selva" />
				<span class="w-full">
					<span class="block text-xs font-semibold text-tinta">¿A dónde?</span>
					<select name="destino" class={selectClass}>
						<option value="">Cualquier destino</option>
						{regions.map((region) => <option value={region.name}>{region.name}</option>)}
					</select>
				</span>
			</label>
			<label class="flex items-center gap-3 rounded-xl px-3 py-2 lg:rounded-none">
				<Icon name="clock" class="h-5 w-5 shrink-0 text-selva" />
				<span class="w-full">
					<span class="block text-xs font-semibold text-tinta">Duración</span>
					<select name="duracion" class={selectClass}>
						<option value="">Cualquier duración</option>
						<option value="1-3">Hasta 3 días</option>
						<option value="4-5">4 a 5 días</option>
						<option value="6-99">6 días o más</option>
					</select>
				</span>
			</label>
			<label class="flex items-center gap-3 rounded-xl px-3 py-2 lg:rounded-none">
				<Icon name="wallet" class="h-5 w-5 shrink-0 text-selva" />
				<span class="w-full">
					<span class="block text-xs font-semibold text-tinta">Presupuesto por persona</span>
					<select name="presupuesto" class={selectClass}>
						<option value="">Cualquier presupuesto</option>
						<option value="0-700">Hasta $700</option>
						<option value="700-1500">$700 a $1.500</option>
						<option value="1500-999999">Más de $1.500</option>
					</select>
				</span>
			</label>
			<div class="sm:col-span-2 lg:col-span-1 lg:pl-3">
				<button
					type="submit"
					class="flex w-full items-center justify-center gap-2 rounded-xl bg-selva px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-selva-claro"
				>
					Buscar <Icon name="search" class="h-4 w-4" />
				</button>
			</div>
		</form>
	</div>

	<!-- ===================== Beneficios ===================== -->
	<section aria-label="Por qué viajar con Quinana" class="mx-auto max-w-5xl px-4 pt-10 sm:px-6">
		<ul class="grid gap-6 rounded-2xl border border-borde/60 bg-white p-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				features.map((feature) => (
					<li class="flex gap-3">
						<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-crema text-selva">
							<Icon name={feature.icon} class="h-5 w-5" />
						</span>
						<span>
							<span class="block text-sm font-bold text-tinta">{feature.title}</span>
							<span class="mt-0.5 block text-xs leading-relaxed text-musgo">{feature.text}</span>
						</span>
					</li>
				))
			}
		</ul>
	</section>

	<!-- ===================== Destinos ===================== -->
	<section id="destinos" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 class="text-3xl font-extrabold text-selva">Destinos populares</h2>
				<p class="mt-2 text-musgo">Cuatro mundos en un solo país.</p>
			</div>
			<a href="#tours" class="inline-flex items-center gap-1.5 text-sm font-semibold text-selva hover:text-terracota">
				Ver todos los tours <Icon name="arrow" class="h-4 w-4" />
			</a>
		</div>

		<ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{
				regionStats.map((region) => (
					<li>
						<a
							href="#tours"
							data-region={region.name}
							class="group relative block aspect-[3/4] overflow-hidden rounded-2xl shadow-md"
						>
							<Image
								src={region.image}
								alt={region.alt}
								widths={[400, 700]}
								sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
								class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent" />
							{region.count > 0 && (
								<span class="absolute top-3 left-3 rounded-full bg-selva/90 px-3 py-1 text-xs font-semibold text-white">
									{region.count} {region.count === 1 ? "tour" : "tours"}
								</span>
							)}
							<div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-5 text-white">
								<span>
									<span class="block text-xl font-bold">{region.name}</span>
									<span class="block text-sm text-white/80">{region.tagline}</span>
								</span>
								{region.from !== null && (
									<span class="text-right text-xs text-white/80">
										desde
										<span class="block text-lg font-bold text-amber-300">{formatPrice(String(region.from))}</span>
									</span>
								)}
							</div>
						</a>
					</li>
				))
			}
		</ul>

		<!-- Estilos de viaje -->
		<ul class="mt-10 flex flex-wrap justify-center gap-x-10 gap-y-5" aria-label="Tipos de viaje que armamos">
			{
				styles.map((style) => (
					<li class="flex items-center gap-3 text-sm font-medium text-tinta">
						<span class="flex h-12 w-12 items-center justify-center rounded-full bg-crema text-selva">
							<Icon name={style.icon} class="h-6 w-6" />
						</span>
						{style.label}
					</li>
				))
			}
		</ul>
	</section>

	<!-- ===================== Tours (CRUD de Django) ===================== -->
	<section id="tours" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 class="text-3xl font-extrabold text-selva">Tours destacados</h2>
				<p class="mt-2 text-musgo">Puntos de partida: todos se ajustan a tus fechas y preferencias.</p>
			</div>
			<p class="text-sm text-musgo" aria-live="polite">
				<span id="tour-count">{tours.length}</span> tours
				<button id="tour-clear" type="button" class="ml-2 font-semibold text-terracota hover:underline" hidden>
					Quitar filtros
				</button>
			</p>
		</div>

		{
			tours.length > 0 ? (
				<ul id="tour-list" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
					{tours.map((tour) => {
						const region = regionFor(tour.destination);
						return (
							<li
								data-tour
								data-destino={tour.destination}
								data-dias={tour.duration_days}
								data-precio={tour.price_usd}
								class="flex flex-col overflow-hidden rounded-2xl border border-borde/70 bg-white shadow-sm transition-shadow hover:shadow-lg"
							>
								<div class="relative aspect-[16/10] bg-crema">
									{region && (
										<Image
											src={region.image}
											alt=""
											widths={[400, 700]}
											sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
											class="h-full w-full object-cover"
										/>
									)}
									<span class="absolute top-3 left-3 flex items-center gap-1 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-selva">
										<Icon name="map-pin" class="h-3.5 w-3.5" /> {tour.destination}
									</span>
								</div>
								<div class="flex flex-1 flex-col p-5">
									<p class="flex items-center gap-1.5 text-xs font-medium text-musgo">
										<Icon name="clock" class="h-4 w-4" /> {tour.duration_label}
									</p>
									<h3 class="mt-2 text-lg leading-snug font-bold text-tinta">{tour.title}</h3>
									<p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-musgo">{tour.description}</p>
									<div class="mt-5 flex items-end justify-between gap-3">
										<p class="text-xs text-musgo">
											Desde
											<span class="block text-2xl font-extrabold text-selva">{formatPrice(tour.price_usd)}</span>
											USD / persona
										</p>
										<a
											href="#cotizar"
											class="rounded-full border border-selva px-4 py-2 text-sm font-semibold text-selva transition-colors hover:bg-selva hover:text-white"
										>
											Consultar
										</a>
									</div>
								</div>
							</li>
						);
					})}
				</ul>
			) : (
				<p class="mt-8 rounded-2xl border border-dashed border-borde p-10 text-center text-musgo">
					Pronto publicaremos nuevos tours. Mientras tanto, cuéntanos tu viaje y te armamos uno a tu
					medida.
				</p>
			)
		}
		<p id="tour-empty" class="mt-8 rounded-2xl border border-dashed border-borde p-10 text-center text-musgo" hidden>
			No hay tours con esos filtros, pero podemos armar uno a tu medida.
			<a href="#cotizar" class="font-semibold text-terracota hover:underline">Solicitar cotización</a>
		</p>
	</section>

	<!-- ===================== Cómo funciona ===================== -->
	<section id="como-funciona" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="grid gap-8 rounded-3xl bg-crema p-8 md:grid-cols-[1fr_2fr] md:p-10">
			<div>
				<p class="text-sm font-semibold text-musgo">¿Cómo planificamos tu viaje?</p>
				<h2 class="mt-2 text-3xl font-extrabold text-selva">Cómo funciona</h2>
				<p class="mt-3 text-sm leading-relaxed text-musgo">
					Sin carrito de compras ni pagos en línea: hablas con una persona que conoce Ecuador.
				</p>
			</div>
			<ol class="grid gap-4 sm:grid-cols-3">
				{
					steps.map((step, index) => (
						<li class="rounded-2xl bg-white p-5 shadow-sm">
							<span class="flex h-9 w-9 items-center justify-center rounded-full bg-terracota text-sm font-bold text-white">
								{index + 1}
							</span>
							<h3 class="mt-3 font-bold text-tinta">{step.title}</h3>
							<p class="mt-1.5 text-sm leading-relaxed text-musgo">{step.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ===================== Llamado a cotizar ===================== -->
	<!-- El formulario de cotización (React + API de leads) es la siguiente feature. -->
	<section id="cotizar" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
		<div class="grid overflow-hidden rounded-3xl bg-selva shadow-xl md:grid-cols-2">
			<Image
				src={banner}
				alt="El volcán Cotopaxi cubierto de nieve y nubes sobre el páramo"
				widths={[600, 900]}
				sizes="(min-width: 768px) 50vw, 100vw"
				class="h-64 w-full object-cover md:h-full"
			/>
			<div class="p-8 text-white md:p-12">
				<p class="text-xs font-semibold tracking-[0.2em] text-amber-300 uppercase">Planifica tu viaje</p>
				<h2 class="mt-3 text-3xl leading-tight font-extrabold md:text-4xl">Tu próxima aventura empieza aquí</h2>
				<p class="mt-4 text-white/80">
					Crea tu cuenta para guardar tus tours favoritos y recibir una propuesta personalizada de un
					experto local.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href="/login#registro"
						class="inline-flex items-center gap-2 rounded-full bg-terracota px-6 py-3 font-semibold text-white transition-colors hover:bg-terracota-oscuro"
					>
						Crear una cuenta <Icon name="arrow" class="h-4 w-4" />
					</a>
					<a
						href="/login#iniciar-sesion"
						class="rounded-full border border-white/50 px-6 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-selva"
					>
						Ya tengo cuenta
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ===================== Cifras ===================== -->
	<section aria-label="Quinana en cifras" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<ul class="grid grid-cols-2 gap-8 lg:grid-cols-4">
			{
				[
					{ icon: "map-pin", value: String(regions.length), label: "Regiones de Ecuador" },
					{ icon: "route", value: String(tours.length), label: "Tours para empezar" },
					{ icon: "compass", value: "100%", label: "Viajes a tu medida" },
					{ icon: "headset", value: "24/7", label: "Asistencia en viaje" },
				].map((stat) => (
					<li class="flex items-center gap-3">
						<Icon name={stat.icon as "map-pin"} class="h-8 w-8 text-selva" />
						<span>
							<span class="block text-2xl font-extrabold text-tinta">{stat.value}</span>
							<span class="block text-xs text-musgo">{stat.label}</span>
						</span>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<script>
	// Filtro del buscador: muestra solo los tours que cumplen destino, duración y precio.
	const form = document.getElementById("tour-search") as HTMLFormElement;
	const cards = [...document.querySelectorAll<HTMLElement>("[data-tour]")];
	const count = document.getElementById("tour-count")!;
	const empty = document.getElementById("tour-empty")!;
	const clear = document.getElementById("tour-clear")!;

	function inRange(value: number, range: string): boolean {
		if (!range) return true;
		const [min, max] = range.split("-").map(Number);
		return value >= min && value <= max;
	}

	function applyFilters(): void {
		const data = new FormData(form);
		const destino = String(data.get("destino") ?? "");
		const duracion = String(data.get("duracion") ?? "");
		const presupuesto = String(data.get("presupuesto") ?? "");
		let visible = 0;
		for (const card of cards) {
			const match =
				(!destino || card.dataset.destino === destino) &&
				inRange(Number(card.dataset.dias), duracion) &&
				inRange(Number(card.dataset.precio), presupuesto);
			card.hidden = !match;
			if (match) visible++;
		}
		count.textContent = String(visible);
		empty.hidden = visible > 0 || cards.length === 0;
		clear.hidden = !destino && !duracion && !presupuesto;
	}

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		applyFilters();
		document.getElementById("tours")?.scrollIntoView();
	});

	clear.addEventListener("click", () => {
		form.reset();
		applyFilters();
	});

	// Las tarjetas de destinos filtran los tours de esa región.
	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-region]")) {
		link.addEventListener("click", () => {
			(form.elements.namedItem("destino") as HTMLSelectElement).value = link.dataset.region!;
			applyFilters();
		});
	}
</script>
