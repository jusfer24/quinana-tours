---
import { Image } from "astro:assets";
import LoginForm from "../components/LoginForm.astro";
import RecoverForm from "../components/RecoverForm.astro";
import RegisterForm from "../components/RegisterForm.astro";
import TermsDialog from "../components/TermsDialog.astro";
import "../styles/auth.css";
// Foto: Omri D. Cohen en Unsplash (https://unsplash.com/photos/MzeSloMrFTY).
// Licencia Unsplash: uso comercial gratuito, sin atribución obligatoria.
import quilotoa from "../assets/quilotoa.jpg";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Quinana Tours · Tours a tu medida por Ecuador</title>
		<meta
			name="description"
			content="Descubre Ecuador a tu manera: crea tu cuenta en Quinana Tours y planifica tu viaje junto a un experto local."
		/>
	</head>
	<body>
		<main class="access-page" data-view="welcome">
			<!-- Marca: arriba a la izquierda, fuera de la tarjeta -->
			<a href="/" class="brand">Quinana Tours</a>

			<div class="frame">
				<!-- Columna de contenido -->
				<div class="content">
					<!-- Vista 1: bienvenida -->
					<section class="welcome view" id="view-welcome" aria-labelledby="welcome-title">
						<h1 id="welcome-title">Descubre Ecuador a tu manera</h1>
						<p class="welcome-text">
							Guarda tus tours favoritos y planifica tu viaje junto a un experto local.
						</p>
						<div class="welcome-actions">
							<button type="button" class="auth-submit" data-go="login">Comenzar</button>
							<button type="button" class="auth-secondary" data-go="register">
								Crear una cuenta
							</button>
						</div>
					</section>

					<!-- Vista 2: inicio de sesión / registro / recuperación -->
					<section class="auth view" id="view-auth" aria-label="Acceso" hidden>
						<button type="button" class="back" data-go="welcome">
							<span aria-hidden="true">←</span> Volver
						</button>

						<div class="tabs" role="tablist" aria-label="Tipo de acceso">
							<button
								type="button"
								role="tab"
								class="tab"
								id="tab-login"
								aria-controls="panel-login"
								aria-selected="true"
								data-go="login"
							>
								Iniciar sesión
							</button>
							<button
								type="button"
								role="tab"
								class="tab"
								id="tab-register"
								aria-controls="panel-register"
								aria-selected="false"
								tabindex="-1"
								data-go="register"
							>
								Registrarse
							</button>
						</div>

						<div role="tabpanel" id="panel-login" aria-labelledby="tab-login">
							<h2 class="panel-title">Bienvenido de nuevo</h2>
							<LoginForm />
						</div>
						<div role="tabpanel" id="panel-register" aria-labelledby="tab-register" hidden>
							<h2 class="panel-title">Comienza tu aventura</h2>
							<RegisterForm />
						</div>
						<div id="panel-recover" aria-labelledby="recover-title" hidden>
							<h2 class="panel-title" id="recover-title">Recupera tu contraseña</h2>
							<p class="panel-text">
								Escribe el correo de tu cuenta y te enviaremos un enlace para crear una nueva contraseña.
							</p>
							<RecoverForm />
						</div>
					</section>
				</div>

				<!-- Columna de la foto -->
				<figure class="photo">
					<Image
						src={quilotoa}
						alt="Laguna del Quilotoa, un lago de cráter turquesa rodeado de montañas en los Andes de Ecuador"
						class="photo-img"
						widths={[480, 800, 1200]}
						sizes="(min-width: 960px) 55vw, 100vw"
						loading="eager"
						fetchpriority="high"
					/>
					<div class="photo-card">
						<p class="photo-card-title">Tours a tu medida</p>
						<p class="photo-card-text">Tú eliges fechas y actividades; nosotros armamos el itinerario.</p>
					</div>
					<figcaption class="photo-caption">
						<p class="photo-slogan">Tu próxima aventura empieza aquí</p>
						<span class="photo-place">Laguna del Quilotoa, Ecuador</span>
					</figcaption>
				</figure>
			</div>
		</main>

		<TermsDialog />
	</body>
</html>

<script>
	import { initAuthForms } from "../lib/auth-forms";

	type View = "welcome" | "login" | "register" | "recover";
	type Panel = Exclude<View, "welcome">;
	const HASHES: Record<View, string> = {
		welcome: "",
		login: "#iniciar-sesion",
		register: "#registro",
		recover: "#recuperar",
	};

	const page = document.querySelector<HTMLElement>(".access-page")!;
	const welcome = document.getElementById("view-welcome")!;
	const auth = document.getElementById("view-auth")!;
	const tablist = document.querySelector<HTMLElement>(".tabs")!;
	const tabs: Record<"login" | "register", HTMLElement> = {
		login: document.getElementById("tab-login")!,
		register: document.getElementById("tab-register")!,
	};
	const panels: Record<Panel, HTMLElement> = {
		login: document.getElementById("panel-login")!,
		register: document.getElementById("panel-register")!,
		recover: document.getElementById("panel-recover")!,
	};

	function viewFromHash(): View {
		const entry = Object.entries(HASHES).find(([, hash]) => hash && hash === location.hash);
		return (entry?.[0] as View) ?? "welcome";
	}

	function show(view: View, focus = true): void {
		page.dataset.view = view;
		welcome.hidden = view !== "welcome";
		auth.hidden = view === "welcome";

		if (view === "welcome") {
			if (focus) welcome.querySelector<HTMLElement>("button")?.focus();
			return;
		}
		tablist.hidden = view === "recover"; // las pestañas no aplican al recuperar
		for (const key of ["login", "register"] as const) {
			const active = key === view;
			tabs[key].setAttribute("aria-selected", String(active));
			tabs[key].tabIndex = active ? 0 : -1;
		}
		for (const key of Object.keys(panels) as Panel[]) {
			panels[key].hidden = key !== view;
		}
		if (focus) panels[view].querySelector<HTMLInputElement>("input")?.focus();
	}

	function go(view: View): void {
		history.pushState(null, "", HASHES[view] || location.pathname);
		show(view);
	}

	document.addEventListener("click", (event) => {
		const target = (event.target as HTMLElement).closest<HTMLElement>("[data-go]");
		if (target) go(target.dataset.go as View);
	});

	// Flechas izquierda/derecha para moverse entre pestañas (patrón ARIA de tabs).
	tablist.addEventListener("keydown", (event) => {
		if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
		const next = page.dataset.view === "register" ? "login" : "register";
		go(next);
		tabs[next].focus();
	});

	window.addEventListener("popstate", () => show(viewFromHash()));

	show(viewFromHash(), false);
	initAuthForms();
</script>

<style is:global>
	:root {
		/* Paleta "Selva y tierra". Para cambiar los colores del acceso basta con editar este bloque. */
		--color-page: #134e4a; /* fondo de la página: verde azulado */
		--color-page-deep: #0b3533;
		--color-page-light: rgba(250, 243, 228, 0.1); /* luces crema muy tenues */
		--color-bg: #1f3d2b; /* verde bosque: títulos */
		--color-surface: #ffffff; /* tarjeta y campos */
		--color-primary: #1f3d2b; /* botones principales y pestaña activa */
		--color-primary-hover: #2e5a3f;
		--color-on-primary: #ffffff;
		--color-accent: #c2562e; /* terracota: enlaces */
		--color-text: #1b2420;
		--color-text-soft: #5d6b63;
		--color-border: #cddbd1;
		--color-focus: rgba(46, 90, 63, 0.12);
		--color-focus-ring: rgba(46, 90, 63, 0.35);
		--color-error: #b42318;
		/* Vidrio: opacidad alta para que se vea elegante sin perder legibilidad. */
		--glass-strong: rgba(255, 255, 255, 0.85);
		--glass-soft: rgba(255, 255, 255, 0.78);
		--glass-border: rgba(255, 255, 255, 0.6);
		--glass-blur: blur(22px) saturate(160%);
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		color: var(--color-text);
		background: var(--color-page);
	}

	[hidden] {
		display: none !important;
	}
</style>

<style>
	/* =====================================================================
	   Base: móvil (< 640px)
	   La foto va arriba como banner y el contenido debajo; la página hace scroll.
	   ===================================================================== */
	.access-page {
		box-sizing: border-box;
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 4rem 0.75rem 0.75rem; /* arriba: espacio para la marca */
		/* Verde azulado con dos luces crema muy tenues (arriba a la izquierda y abajo a la derecha). */
		background:
			radial-gradient(ellipse 60% 50% at 12% 8%, var(--color-page-light), transparent 70%),
			radial-gradient(ellipse 55% 45% at 90% 95%, var(--color-page-light), transparent 70%),
			linear-gradient(155deg, var(--color-page) 0%, var(--color-page-deep) 100%);
		background-attachment: fixed;
	}

	/* Marca fija en la esquina superior izquierda. */
	.brand {
		position: absolute;
		top: 1.4rem;
		left: 1.25rem;
		font-weight: 800;
		font-size: 0.95rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		text-decoration: none;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
	}

	.brand:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
		border-radius: 2px;
	}

	/* Tarjeta de vidrio esmerilado que contiene contenido y foto. */
	.frame {
		box-sizing: border-box;
		display: flex;
		flex-direction: column-reverse; /* en móvil la foto queda arriba */
		width: 100%;
		padding: 0.6rem;
		background: var(--glass-strong);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		border: 1px solid var(--glass-border);
		border-radius: 1.5rem;
		box-shadow: 0 30px 70px rgba(0, 0, 0, 0.3);
	}

	.content {
		display: flex;
		flex-direction: column;
		padding: 1.5rem 0.9rem 1.25rem;
	}

	.view {
		width: 100%;
		max-width: 400px;
		margin-inline: auto;
		animation: fade-in 0.3s ease-out;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* ---------- Bienvenida ---------- */
	.welcome h1 {
		margin: 0 0 0.75rem;
		font-size: 2rem;
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: var(--color-bg);
	}

	.welcome-text {
		margin: 0 0 1.75rem;
		font-size: 1.02rem;
		line-height: 1.55;
		color: var(--color-text-soft);
	}

	.welcome-actions {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	/* ---------- Acceso ---------- */
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1rem;
		padding: 0.3rem 0.5rem 0.3rem 0;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text-soft);
		background: none;
		border: none;
		cursor: pointer;
	}

	.back:hover {
		color: var(--color-text);
	}

	.back:focus-visible {
		outline: 2px solid var(--color-focus-ring);
		border-radius: 0.4rem;
	}

	/* Pestañas como en la referencia: activa rellena, inactiva con borde. */
	.tabs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
	}

	.tab {
		padding: 0.7rem 0.5rem;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1.5px solid var(--color-text);
		border-radius: 0.6rem;
		cursor: pointer;
		transition: background 0.15s, color 0.15s;
	}

	.tab:hover {
		background: #f4f7f5;
	}

	.tab[aria-selected="true"] {
		color: var(--color-on-primary);
		background: var(--color-primary);
		border-color: var(--color-primary);
	}

	.tab:focus-visible {
		outline: 3px solid var(--color-focus-ring);
		outline-offset: 2px;
	}

	.panel-title {
		margin: 0 0 1.1rem;
		font-size: 1.6rem;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.panel-text {
		margin: -0.4rem 0 1.4rem;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--color-text-soft);
	}

	/* ---------- Foto ---------- */
	.photo {
		position: relative;
		height: 210px;
		margin: 0;
		overflow: hidden;
		border-radius: 1.1rem;
	}

	.photo-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 45%;
	}

	/* Degradado para que el texto blanco sea legible sobre la foto. */
	.photo::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(10, 25, 16, 0.65) 100%);
		pointer-events: none;
	}

	.photo-card {
		display: none;
	}

	.photo-caption {
		position: absolute;
		right: 1rem;
		bottom: 0.9rem;
		left: 1rem;
		z-index: 1;
		color: #fff;
	}

	.photo-slogan {
		margin: 0 0 0.5rem;
		font-size: 1.3rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.photo-place {
		display: inline-block;
		padding: 0.3rem 0.75rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-bg);
		background: var(--glass-soft);
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
		border: 1px solid var(--glass-border);
		border-radius: 999px;
	}

	/* =====================================================================
	   Tableta (≥ 640px): tarjeta centrada, foto como banner más alto
	   ===================================================================== */
	@media (min-width: 640px) {
		.access-page {
			justify-content: center;
			padding: 4.5rem 2rem 2rem;
		}

		.brand {
			top: 1.75rem;
			left: 2rem;
		}

		.frame {
			max-width: 600px;
			padding: 0.75rem;
			border-radius: 1.75rem;
		}

		.content {
			padding: 2rem 1.5rem 1.5rem;
		}

		.photo {
			height: 260px;
			border-radius: 1.25rem;
		}

		.welcome h1 {
			font-size: 2.5rem;
		}

		.welcome-actions {
			flex-direction: row;
		}
	}

	/* =====================================================================
	   Escritorio (≥ 960px): dos columnas como en la referencia —
	   contenido a la izquierda, foto a la derecha; la tarjeta tiene alto fijo
	   (no cambia al pasar de pestaña) y el contenido se desplaza si no cabe.
	   ===================================================================== */
	@media (min-width: 960px) {
		.access-page {
			padding: 5rem 4vw 2.5rem;
		}

		.brand {
			top: 2rem;
			left: 4vw;
		}

		.frame {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			max-width: 1180px;
			height: min(760px, calc(100dvh - 7.5rem));
			padding: 0.9rem;
			border-radius: 2rem;
		}

		.content {
			justify-content: safe center;
			overflow-y: auto;
			padding: 2rem 2.5rem;
		}

		.photo {
			height: auto;
			border-radius: 1.5rem;
		}

		.photo-caption {
			right: 1.75rem;
			bottom: 1.75rem;
			left: 1.75rem;
		}

		.photo-slogan {
			max-width: 18rem;
			font-size: 2rem;
		}

		.photo-place {
			font-size: 0.85rem;
		}

		/* Tarjeta flotante sobre la foto (como en la referencia). */
		.photo-card {
			display: block;
			position: absolute;
			top: 1.5rem;
			right: 1.5rem;
			z-index: 1;
			max-width: 15rem;
			padding: 1rem 1.15rem;
			background: var(--glass-soft);
			backdrop-filter: var(--glass-blur);
			-webkit-backdrop-filter: var(--glass-blur);
			border: 1px solid var(--glass-border);
			border-radius: 1rem;
			box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
		}

		.photo-card-title {
			margin: 0 0 0.3rem;
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--color-bg);
		}

		.photo-card-text {
			margin: 0;
			font-size: 0.82rem;
			line-height: 1.45;
			color: var(--color-text-soft);
		}

		.welcome h1 {
			font-size: 3rem;
		}
	}

	/* =====================================================================
	   Pantallas grandes (≥ 1440px)
	   ===================================================================== */
	@media (min-width: 1440px) {
		.content {
			padding-inline: 3.5rem;
		}

		.welcome h1 {
			font-size: 3.4rem;
		}

		.photo-slogan {
			font-size: 2.3rem;
		}
	}

	/* =====================================================================
	   Pantallas bajas (laptops pequeñas)
	   ===================================================================== */
	@media (min-width: 960px) and (max-height: 720px) {
		.access-page {
			padding-top: 3.75rem;
			padding-bottom: 1rem;
		}

		.brand {
			top: 1.25rem;
		}

		.frame {
			height: calc(100dvh - 4.75rem);
		}

		.content {
			padding-block: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.view {
			animation: none;
		}

		.tab {
			transition: none;
		}
	}
</style>
