---
import { Image } from "astro:assets";
import LoginForm from "../components/LoginForm.astro";
import RecoverForm from "../components/RecoverForm.astro";
import RegisterForm from "../components/RegisterForm.astro";
import StaffLoginForm from "../components/StaffLoginForm.astro";
import TermsDialog from "../components/TermsDialog.astro";
import "../styles/auth.css";
// Galería de la tarjeta (y del fondo desenfocado). Fotos con licencia Unsplash:
// uso comercial gratuito, sin atribución obligatoria.
// - Quilotoa: Robinson Recalde (https://unsplash.com/photos/ifR_v_GWliQ)
// - Baños: Andres Medina (https://unsplash.com/photos/F26TDHAk-1w)
// - Galápagos: Heidi Bruce (https://unsplash.com/photos/LJIjXgutX4g)
// - Cuyabeno: https://unsplash.com/photos/-yRBdN28AVU
import quilotoa from "../assets/acceso/quilotoa-laguna.jpg";
import cotopaxi from "../assets/destinos/cotopaxi-banner.jpg";
import banos from "../assets/acceso/banos-montanas.jpg";
import galapagos from "../assets/acceso/galapagos-bartolome.jpg";
import cuyabeno from "../assets/acceso/cuyabeno-mono.jpg";

// Cada foto se muestra 4 s; la duración total del ciclo se calcula en CSS con --slides.
const slides = [
	{
		src: quilotoa,
		place: "Laguna del Quilotoa, Ecuador",
		alt: "Laguna del Quilotoa, un lago de cráter turquesa rodeado de montañas en los Andes de Ecuador",
	},
	{
		src: cotopaxi,
		place: "Volcán Cotopaxi, Ecuador",
		alt: "Volcán Cotopaxi con la cumbre nevada entre nubes sobre el páramo andino",
	},
	{
		src: galapagos,
		place: "Isla Bartolomé, Galápagos",
		alt: "Vista de la Isla Bartolomé con sus dos playas de arena y la roca Pináculo en Galápagos",
	},
	{
		src: banos,
		place: "Baños de Agua Santa, Ecuador",
		alt: "Valle verde de Baños de Agua Santa rodeado de montañas cubiertas de nubes",
	},
	{
		src: cuyabeno,
		place: "Reserva Cuyabeno, Amazonía",
		alt: "Mono capuchino de frente blanca mirando a la cámara en la Reserva Cuyabeno",
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Acceso · Quinana Tours</title>
		<meta name="description" content="Inicia sesión o crea tu cuenta en Quinana Tours." />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<main class="access-page" data-view="welcome">
			<!-- Fondo decorativo: la misma galería, desenfocada y sincronizada con la tarjeta.
			     Usa el ancho de 800 px, que la foto de la tarjeta también usa en escritorio,
			     así el navegador descarga cada imagen una sola vez. -->
			<div class="backdrop" aria-hidden="true" style={`--slides: ${slides.length}`}>
				<div class="backdrop-track">
					{
						slides.map((slide, i) => (
							<Image
								src={slide.src}
								alt=""
								class="backdrop-img slide"
								style={`--i: ${i}`}
								widths={[800]}
								sizes="100vw"
								loading={i === 0 ? "eager" : "lazy"}
								decoding="async"
							/>
						))
					}
				</div>
			</div>

			<!-- Marca: arriba a la izquierda, fuera de la tarjeta -->
			<a href="/" class="brand">Quinana Tours</a>

			<div class="frame">
				<!-- Columna de contenido -->
				<div class="content">
					<!-- Vista 1: bienvenida -->
					<section class="welcome view" id="view-welcome" aria-labelledby="welcome-title">
						<h1 id="welcome-title">Descubre Ecuador a tu manera</h1>
						<p class="welcome-text">
							Guarda tus tours favoritos y planifica tu viaje junto a un experto local.
						</p>
						<div class="welcome-actions">
							<button type="button" class="auth-submit" data-go="login">Comenzar</button>
							<button type="button" class="auth-secondary" data-go="register">
								Crear una cuenta
							</button>
						</div>
					</section>

					<!-- Vista 2: inicio de sesión / registro / recuperación -->
					<section class="auth view" id="view-auth" aria-label="Acceso" hidden>
						<button type="button" class="back" data-go="welcome">
							<span aria-hidden="true">←</span> Volver
						</button>

						<div class="tabs" role="tablist" aria-label="Tipo de acceso">
							<button
								type="button"
								role="tab"
								class="tab"
								id="tab-login"
								aria-controls="panel-login"
								aria-selected="true"
								data-go="login"
							>
								Iniciar sesión
							</button>
							<button
								type="button"
								role="tab"
								class="tab"
								id="tab-register"
								aria-controls="panel-register"
								aria-selected="false"
								tabindex="-1"
								data-go="register"
							>
								Registrarse
							</button>
						</div>

						<div role="tabpanel" id="panel-login" aria-labelledby="tab-login">
							<h2 class="panel-title">Bienvenido de nuevo</h2>
							<LoginForm />
							<p class="staff-entry">
								¿Eres del equipo Quinana?
								<button type="button" class="auth-link" data-go="staff">Ingresar al panel (CRM)</button>
							</p>
						</div>
						<div role="tabpanel" id="panel-register" aria-labelledby="tab-register" hidden>
							<h2 class="panel-title">Comienza tu aventura</h2>
							<RegisterForm />
						</div>
						<div id="panel-recover" aria-labelledby="recover-title" hidden>
							<h2 class="panel-title" id="recover-title">Recupera tu contraseña</h2>
							<p class="panel-text">
								Escribe el correo de tu cuenta y te enviaremos un enlace para crear una nueva contraseña.
							</p>
							<RecoverForm />
						</div>
						<div id="panel-staff" aria-labelledby="staff-title" hidden>
							<h2 class="panel-title" id="staff-title">Acceso del equipo</h2>
							<p class="panel-text">
								Para quienes gestionan el catálogo y las cotizaciones. Ingresa con tu usuario del panel.
							</p>
							<StaffLoginForm />
						</div>
					</section>
				</div>

				<!-- Columna de la foto -->
				<!-- Galería en bucle (solo CSS): cada foto entra con un fundido y un zoom lento. -->
				<figure class="photo" style={`--slides: ${slides.length}`}>
					{
						slides.map((slide, i) => (
							<Image
								src={slide.src}
								alt={slide.alt}
								class="photo-img slide"
								style={`--i: ${i}`}
								widths={[480, 800, 1200]}
								sizes="(min-width: 960px) 55vw, 100vw"
								loading={i === 0 ? "eager" : "lazy"}
								fetchpriority={i === 0 ? "high" : "auto"}
							/>
						))
					}
					<div class="photo-card">
						<p class="photo-card-title">Tours a tu medida</p>
						<p class="photo-card-text">Tú eliges fechas y actividades; nosotros armamos el itinerario.</p>
					</div>
					<figcaption class="photo-caption">
						<p class="photo-slogan">Tu próxima aventura empieza aquí</p>
						<span class="photo-places">
							{
								slides.map((slide, i) => (
									<span class="photo-place slide" style={`--i: ${i}`}>
										{slide.place}
									</span>
								))
							}
						</span>
					</figcaption>
				</figure>
			</div>
		</main>

		<TermsDialog />
	</body>
</html>

<script>
	import { initAuthForms } from "../lib/auth-forms";

	type View = "welcome" | "login" | "register" | "recover" | "staff";
	type Panel = Exclude<View, "welcome">;
	const HASHES: Record<View, string> = {
		welcome: "",
		login: "#iniciar-sesion",
		register: "#registro",
		recover: "#recuperar",
		staff: "#equipo",
	};

	const page = document.querySelector<HTMLElement>(".access-page")!;
	const welcome = document.getElementById("view-welcome")!;
	const auth = document.getElementById("view-auth")!;
	const tablist = document.querySelector<HTMLElement>(".tabs")!;
	const tabs: Record<"login" | "register", HTMLElement> = {
		login: document.getElementById("tab-login")!,
		register: document.getElementById("tab-register")!,
	};
	const panels: Record<Panel, HTMLElement> = {
		login: document.getElementById("panel-login")!,
		register: document.getElementById("panel-register")!,
		recover: document.getElementById("panel-recover")!,
		staff: document.getElementById("panel-staff")!,
	};

	function viewFromHash(): View {
		const entry = Object.entries(HASHES).find(([, hash]) => hash && hash === location.hash);
		return (entry?.[0] as View) ?? "welcome";
	}

	function show(view: View, focus = true): void {
		page.dataset.view = view;
		welcome.hidden = view !== "welcome";
		auth.hidden = view === "welcome";

		if (view === "welcome") {
			if (focus) welcome.querySelector<HTMLElement>("button")?.focus();
			return;
		}
		tablist.hidden = view === "recover" || view === "staff"; // las pestañas son solo de viajeros
		for (const key of ["login", "register"] as const) {
			const active = key === view;
			tabs[key].setAttribute("aria-selected", String(active));
			tabs[key].tabIndex = active ? 0 : -1;
		}
		for (const key of Object.keys(panels) as Panel[]) {
			panels[key].hidden = key !== view;
		}
		if (focus) panels[view].querySelector<HTMLInputElement>("input")?.focus();
	}

	function go(view: View): void {
		history.pushState(null, "", HASHES[view] || location.pathname);
		show(view);
	}

	document.addEventListener("click", (event) => {
		const target = (event.target as HTMLElement).closest<HTMLElement>("[data-go]");
		if (target) go(target.dataset.go as View);
	});

	// Flechas izquierda/derecha para moverse entre pestañas (patrón ARIA de tabs).
	tablist.addEventListener("keydown", (event) => {
		if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
		const next = page.dataset.view === "register" ? "login" : "register";
		go(next);
		tabs[next].focus();
	});

	window.addEventListener("popstate", () => show(viewFromHash()));

	show(viewFromHash(), false);
	initAuthForms();
</script>

<style is:global>
	/* Transición suave al navegar desde/hacia la página principal (ver global.css). */
	@view-transition {
		navigation: auto;
	}

	:root {
		/* Paleta "Selva y tierra". Para cambiar los colores del acceso basta con editar este bloque. */
		--color-page: #134e4a; /* fondo de la página: verde azulado */
		--color-page-deep: #0b3533;
		--color-page-light: rgba(250, 243, 228, 0.1); /* luces crema muy tenues */
		--color-bg: #1f3d2b; /* verde bosque: títulos */
		--color-surface: #ffffff; /* tarjeta y campos */
		--color-primary: #1f3d2b; /* botones principales y pestaña activa */
		--color-primary-hover: #2e5a3f;
		--color-on-primary: #ffffff;
		--color-accent: #c2562e; /* terracota: enlaces */
		--color-text: #1b2420;
		--color-text-soft: #5d6b63;
		--color-border: #cddbd1;
		--color-focus: rgba(46, 90, 63, 0.12);
		--color-focus-ring: rgba(46, 90, 63, 0.35);
		--color-error: #b42318;
		/* Vidrio: opacidad alta para que se vea elegante sin perder legibilidad. */
		--glass-soft: rgba(255, 255, 255, 0.78);
		--glass-border: rgba(255, 255, 255, 0.6);
		--glass-blur: blur(22px) saturate(160%);
		/* Tarjeta central: marco de vidrio translúcido y panel esmerilado para el formulario. */
		--glass-frame: rgba(255, 255, 255, 0.16);
		--glass-frame-border: rgba(255, 255, 255, 0.38);
		--glass-frame-blur: blur(24px) saturate(150%);
		--glass-panel: rgba(255, 255, 255, 0.78);
		--glass-panel-border: rgba(255, 255, 255, 0.55);
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		color: var(--color-text);
		background: var(--color-page);
	}

	[hidden] {
		display: none !important;
	}
</style>

<style>
	/* =====================================================================
	   Base: móvil (< 640px)
	   La foto va arriba como banner y el contenido debajo; la página hace scroll.
	   ===================================================================== */
	.access-page {
		box-sizing: border-box;
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 4rem 0.75rem 0.75rem; /* arriba: espacio para la marca */
		/* Verde azulado con dos luces crema muy tenues (arriba a la izquierda y abajo a la derecha). */
		background:
			radial-gradient(ellipse 60% 50% at 12% 8%, var(--color-page-light), transparent 70%),
			radial-gradient(ellipse 55% 45% at 90% 95%, var(--color-page-light), transparent 70%),
			linear-gradient(155deg, var(--color-page) 0%, var(--color-page-deep) 100%);
		background-attachment: fixed;
		isolation: isolate; /* el fondo con z-index -1 queda dentro de la página */
	}

	/* ---------- Galería en bucle ----------
	   Las fotos de la tarjeta, los nombres de lugar y el fondo comparten el mismo
	   ritmo: cada foto se ve 4 s y se funde con la siguiente durante 1 s. Todas
	   arrancan juntas al cargar, así que el fondo siempre acompaña a la tarjeta.
	   Los porcentajes de los @keyframes asumen 5 fotos (cada una ocupa 20 % del ciclo,
	   el fundido 5 %); si cambia el número de fotos, hay que ajustarlos. */
	.slide {
		--slide-time: 4s;
		--fade-time: 1s;
		opacity: 0;
		animation-duration: calc(var(--slides) * var(--slide-time));
		/* La primera foto arranca ya visible (sin fundido inicial). */
		animation-delay: calc(var(--i) * var(--slide-time) - var(--fade-time));
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
		animation-fill-mode: backwards;
	}

	@keyframes slide-fade {
		0% {
			opacity: 0;
		}
		5%,
		20% {
			opacity: 1;
		}
		25%,
		100% {
			opacity: 0;
		}
	}

	/* Igual que slide-fade, con un acercamiento lento mientras la foto está visible. */
	@keyframes slide-ken-burns {
		0% {
			opacity: 0;
			transform: scale(1);
		}
		5% {
			opacity: 1;
		}
		20% {
			opacity: 1;
		}
		25%,
		100% {
			opacity: 0;
			transform: scale(1.1);
		}
	}

	/* Fondo: la galería con desenfoque leve; el degradado verde de arriba queda
	   como respaldo mientras carga. */
	.backdrop {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	/* Paneo lento de todo el fondo, independiente del cambio de foto. */
	.backdrop-track {
		position: absolute;
		inset: 0;
		transform: scale(1.06); /* evita el borde claro que deja el desenfoque */
		animation: backdrop-drift 40s ease-in-out infinite alternate;
	}

	@keyframes backdrop-drift {
		to {
			transform: scale(1.14) translate(-2%, -1.5%);
		}
	}

	.backdrop-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: blur(8px);
		animation-name: slide-fade;
	}

	/* Velo verde oscuro: une la foto con la paleta y hace resaltar la marca y la tarjeta. */
	.backdrop::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(160deg, rgba(11, 53, 51, 0.25) 0%, rgba(11, 53, 51, 0.5) 100%);
	}

	/* Marca fija en la esquina superior izquierda. */
	.brand {
		position: absolute;
		top: 1.4rem;
		left: 1.25rem;
		font-weight: 800;
		font-size: 0.95rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		text-decoration: none;
		text-shadow:
			0 1px 2px rgba(0, 0, 0, 0.35),
			0 2px 14px rgba(0, 0, 0, 0.45);
	}

	.brand:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 4px;
		border-radius: 2px;
	}

	/* Tarjeta de vidrio (glassmorphism): deja ver el fondo desenfocado a través del marco. */
	.frame {
		box-sizing: border-box;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column-reverse; /* en móvil la foto queda arriba */
		gap: 0.6rem;
		width: 100%;
		padding: 0.6rem;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), var(--glass-frame) 60%);
		backdrop-filter: var(--glass-frame-blur);
		-webkit-backdrop-filter: var(--glass-frame-blur);
		border: 1px solid var(--glass-frame-border);
		border-radius: 1.5rem;
		box-shadow:
			0 30px 70px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.45); /* brillo en el borde superior */
	}

	/* Destello de luz que recorre el vidrio cada pocos segundos; queda detrás del
	   panel y de la foto, así que solo se ve en el marco. */
	.frame::before {
		content: "";
		position: absolute;
		inset: -50% auto -50% -60%;
		z-index: 0;
		width: 45%;
		background: linear-gradient(
			100deg,
			transparent 0%,
			rgba(255, 255, 255, 0.35) 50%,
			transparent 100%
		);
		transform: translateX(0) rotate(12deg);
		animation: glass-shine 9s ease-in-out infinite;
		pointer-events: none;
	}

	@keyframes glass-shine {
		0%,
		55% {
			transform: translateX(0) rotate(12deg);
		}
		100% {
			transform: translateX(480%) rotate(12deg);
		}
	}

	/* Panel esmerilado más opaco para que el formulario se lea bien sobre el vidrio. */
	.content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		padding: 1.5rem 0.9rem 1.25rem;
		background: var(--glass-panel);
		border: 1px solid var(--glass-panel-border);
		border-radius: 1.1rem;
	}

	.view {
		width: 100%;
		max-width: 400px;
		margin-inline: auto;
		animation: fade-in 0.3s ease-out;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* ---------- Bienvenida ---------- */
	.welcome h1 {
		margin: 0 0 0.75rem;
		font-size: 2rem;
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: var(--color-bg);
		/* Relieve: brillo claro debajo y sombra verde difusa. */
		text-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7),
			0 4px 18px rgba(31, 61, 43, 0.25);
	}

	.welcome-text {
		margin: 0 0 1.75rem;
		font-size: 1.02rem;
		line-height: 1.55;
		color: var(--color-text-soft);
	}

	.welcome-actions {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	/* El botón principal de la bienvenida "respira" con un halo suave. */
	.welcome .auth-submit {
		animation: cta-glow 2.8s ease-in-out infinite;
	}

	@keyframes cta-glow {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(46, 90, 63, 0.45);
		}
		50% {
			box-shadow: 0 0 0 8px rgba(46, 90, 63, 0);
		}
	}

	/* ---------- Acceso ---------- */
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1rem;
		padding: 0.3rem 0.5rem 0.3rem 0;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text-soft);
		background: none;
		border: none;
		cursor: pointer;
	}

	.back:hover {
		color: var(--color-text);
	}

	.back:focus-visible {
		outline: 2px solid var(--color-focus-ring);
		border-radius: 0.4rem;
	}

	/* Pestañas como en la referencia: activa rellena, inactiva con borde. */
	.tabs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
	}

	.tab {
		padding: 0.7rem 0.5rem;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1.5px solid var(--color-text);
		border-radius: 0.6rem;
		cursor: pointer;
		transition: background 0.15s, color 0.15s;
	}

	.tab:hover {
		background: #f4f7f5;
	}

	.tab[aria-selected="true"] {
		color: var(--color-on-primary);
		background: var(--color-primary);
		border-color: var(--color-primary);
	}

	.tab:focus-visible {
		outline: 3px solid var(--color-focus-ring);
		outline-offset: 2px;
	}

	.panel-title {
		margin: 0 0 1.1rem;
		font-size: 1.6rem;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-text);
		text-shadow:
			0 1px 0 rgba(255, 255, 255, 0.7),
			0 3px 14px rgba(31, 61, 43, 0.22);
	}

	.staff-entry {
		margin: 1.25rem 0 0;
